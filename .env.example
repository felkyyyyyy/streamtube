# Application Port (default 80 for clean Ubuntu deployment)
APP_PORT=80
APP_ENV=production

# Cryptographic Secrets (auto-generated by deploy.sh)
SECRET_KEY=replace-with-openssl-rand-hex-32
MEDIA_SIGNING_SECRET=replace-with-openssl-rand-hex-32
COOKIE_SECURE=false

# PostgreSQL
POSTGRES_USER=streamtube
POSTGRES_PASSWORD=streamtube_change_me
POSTGRES_DB=streamtube

# MinIO (S3 Object Storage)
MINIO_ROOT_USER=streamtube_minio
MINIO_ROOT_PASSWORD=streamtube_minio_change_me
S3_BUCKET=streamtube-media

# CORS (comma-separated origins for dev tools if needed)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1
